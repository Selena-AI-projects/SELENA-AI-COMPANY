NEXT_PUBLIC_SITE_URL=https://www.selenasystems.com

# Client portal (app.selenasystems.com). Links into the portal show by
# default. Set to "false" to hide them from the header, mobile menu, footer
# and the Visibility/Pricing pages while the portal is unreachable.
NEXT_PUBLIC_CLIENT_PORTAL_ENABLED=

# Public contact links shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_WHATSAPP=+7 921 933-11-13

# Lead delivery. Configure at least one delivery target in Vercel.
LEADS_TELEGRAM_BOT_TOKEN=
LEADS_TELEGRAM_CHAT_ID=
LEADS_WEBHOOK_URL=

# Visibility diagnostics — Supabase (Decision Log D-005, NEEDS_OWNER).
# Everything below is unset in every environment today; the mocked
# Phase 1 flow (lib/diagnostics/mockRun.ts) works without any of it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the Phase 1 mock-run token (lib/diagnostics/mockRun.ts). Optional:
# falls back to a random per-process secret if unset, which just means
# tokens stop verifying across a redeploy — fine for the mock phase.
VISIBILITY_MOCK_SIGNING_SECRET=

# Visibility feature flags (SSOT §10.6, §27.7). All default OFF; set to
# "true" to enable. Live/paid ones (SE_RANKING, APIFY, SUBSCRIPTIONS,
# MONITOR, GSC/GA4_OAUTH) additionally require the matching Decision Log
# item (see docs/visibility/SELENA_VISIBILITY_DECISION_LOG.md) before
# they should ever be turned on outside local dev.
VISIBILITY_ENABLED=
VISIBILITY_FREE_CHECK_ENABLED=
VISIBILITY_EMAIL_UNLOCK_ENABLED=
VISIBILITY_LIVE_CRAWLER_ENABLED=
VISIBILITY_PAGESPEED_ENABLED=
VISIBILITY_AI_SAMPLE_ENABLED=
VISIBILITY_SE_RANKING_ENABLED=
VISIBILITY_APIFY_ENABLED=
VISIBILITY_GSC_OAUTH_ENABLED=
VISIBILITY_GA4_OAUTH_ENABLED=
VISIBILITY_SUBSCRIPTIONS_ENABLED=
VISIBILITY_MONITOR_ENABLED=
VISIBILITY_PUBLIC_REPORTS_ENABLED=
VISIBILITY_PROCESS_CHECK_ENABLED=
VISIBILITY_VILLA_REDIRECT_ENABLED=
VISIBILITY_PERSONALIZED_EXPLANATION_ENABLED=

# Personalized explanation layer (Decision Log D-023, D-024). Off by default
# — flag above must also be "true". Model comes from config, never hardcoded
# in business logic; only gpt-5-mini / gpt-5-nano are allowlisted regardless
# of what this is set to (lib/visibility/explanation/generate.ts).
OPENAI_API_KEY=
VISIBILITY_EXPLANATION_MODEL=gpt-5-mini

# Best-effort, non-durable guardrails only (in-memory, per-process — resets
# on cold start, does not sum across serverless instances). Not a substitute
# for a durable spend cap; see Decision Log D-024.
VISIBILITY_EXPLANATION_PER_IP_PER_HOUR=
VISIBILITY_EXPLANATION_DAILY_SOFT_CAP=
